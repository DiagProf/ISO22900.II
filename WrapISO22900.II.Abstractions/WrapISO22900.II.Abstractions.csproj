<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<ImplicitUsings>disable</ImplicitUsings>
		<Nullable>warnings</Nullable>
		<RootNamespace>ISO22900.II</RootNamespace>
		<PackageId>ISO22900.II-Sharp.Abstractions</PackageId>
		<Description>Interfaces (IDiagPduApiOneSysLevel, IModule, IComLogicalLink, IComPrimitive), data classes, enums and exceptions of ISO22900.II-Sharp without any native D-PDU API dependency. Reference this package to write your own implementation below the interfaces, e.g. a simulator, a non ISO 22900-2 VCI bridge or a test double. The ISO22900.II-Sharp package depends on it, so normal users get it automatically.</Description>
		<PackageTags>ISO22900-2;D-PDU-API;VCI;Abstractions;Mock;Simulation</PackageTags>
		<RepositoryUrl>https://github.com/DiagProf/ISO22900.II/tree/master/WrapISO22900.II.Abstractions</RepositoryUrl>
		<PackageReadmeFile>READMEForNuGet.md</PackageReadmeFile>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<!-- Not every enum value and data member is documented yet. -->
		<NoWarn>$(NoWarn);CS1591;CS1573;CS1572;CS1570</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<!-- The native implementation (and its tests) fill internal members such as handles and the visitor hooks. -->
		<InternalsVisibleTo Include="WrapISO22900.II" />
		<InternalsVisibleTo Include="WrapISO22900.II.Test" />
	</ItemGroup>

	<ItemGroup>
		<None Update="READMEForNuGet.md">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>

</Project>
