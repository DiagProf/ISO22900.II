<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
	  <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>warnings</Nullable>
    <RootNamespace>$(MSBuildProjectName.Replace("Wrap", "").Replace(" ", "_"))</RootNamespace>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
	<PackageId>ISO22900.II-Sharp</PackageId>
	<Description>ISO22900.II-Sharp handles all the details of operating with unmanaged ISO 22900-2 spec library (also called D-PDU-API) and lets you deal with the important stuff.</Description>
	<InformationalVersion>This is a prerelease package</InformationalVersion>
	<PackageTags>ISO22900-2;D-PDU-API;VCI;alternativeTo;PassThru;J2534</PackageTags>
	<RepositoryUrl>https://github.com/DiagProf/ISO22900.II/tree/master/WrapISO22900.II</RepositoryUrl>
	<PackageReadmeFile>READMEForNuGet.md</PackageReadmeFile>
	<PackageReleaseNotes>1.4.0-beta: The interfaces, data classes, enums and exceptions moved into the new package ISO22900.II-Sharp.Abstractions (same namespaces, type forwarders keep existing binaries working). New interfaces IComPrimitive and IDiagPduApiOneSysLevel; IModule.OpenComLogicalLink returns IComLogicalLink and IComLogicalLink.StartCop returns IComPrimitive, so code using the interfaces must be recompiled. IModule, IComLogicalLink and IComPrimitive derive from IDisposable. Data classes returned by the interfaces have public constructors so own implementations (simulators, test doubles) can create them. The blocking ComPrimitive.WaitForCopResult(ct) now also rethrows OperationCanceledException when ct is cancelled (same behavior as the async variant); ApiModifications.LEGACY_SWALLOW_COP_CANCELLATION restores the old behavior for both. 1.3.2-beta: ComPrimitive.WaitForCopResultAsync(ct) now rethrows OperationCanceledException when ct is cancelled instead of returning an empty result. Use ApiModifications.LEGACY_SWALLOW_COP_CANCELLATION to keep the old behavior.</PackageReleaseNotes>
   </PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.13" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\WrapISO22900.II.Abstractions\WrapISO22900.II.Abstractions.csproj" />
	</ItemGroup>

	<!-- This assembly uses internal members of the Abstractions assembly (InternalsVisibleTo),
		 so the package dependency must be the exact same version: [x.y.z] instead of >= x.y.z -->
	<Target Name="PinProjectReferenceVersionsExactly" AfterTargets="_GetProjectReferenceVersions">
		<ItemGroup>
			<_PinnedProjectReferencesWithVersions Include="@(_ProjectReferencesWithVersions)">
				<ProjectVersion>[%(_ProjectReferencesWithVersions.ProjectVersion)]</ProjectVersion>
			</_PinnedProjectReferencesWithVersions>
			<_ProjectReferencesWithVersions Remove="@(_ProjectReferencesWithVersions)" />
			<_ProjectReferencesWithVersions Include="@(_PinnedProjectReferencesWithVersions)" />
		</ItemGroup>
	</Target>

	<ItemGroup>
		<AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
			<_Parameter1>$(AssemblyName).Test</_Parameter1>
		</AssemblyAttribute>
	</ItemGroup>

	<ItemGroup>
	  <None Update="READMEForNuGet.md">
	    <Pack>True</Pack>
	    <PackagePath>\</PackagePath>
	  </None>
	</ItemGroup>
	
</Project>
